@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies
find_dependency(Threads REQUIRED)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/GraphEngineTargets.cmake")

# Set variables
set(GraphEngine_VERSION @PROJECT_VERSION@)
set(GraphEngine_FOUND TRUE)

# Check if all required components are available
check_required_components(GraphEngine)
